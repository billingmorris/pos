<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extend the POS receipt template -->
    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <!-- Insert the partner name before the order lines -->
        <xpath expr="//div[hasclass('orderlines')]" position="before">
        <div>**************</div>
        <t t-if="env.pos.get_client().name">
                <span>Name:</span>
                <span t-esc="env.pos.get_client().name"/><br/>
        </t>
         <div t-if="receipt.partner" class="partner-name" style="margin-bottom: 10px;">
                <strong>Customer:</strong> <span t-esc="receipt.partner.name"/>
            </div>
            
            
            
        </xpath>
    </t>
</templates>
