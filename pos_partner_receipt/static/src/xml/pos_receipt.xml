<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extend the POS receipt template -->
    <t t-extend="OrderReceipt">
        <!-- Insert the partner name after the company info and before the products -->
        <t t-jquery=".receipt-order .receipt-header" t-operation="after">
            <!-- Check if a partner is associated with the order -->
            <div t-if="order.partner_id" class="partner-name" style="margin-bottom: 10px;">
                <strong>Customer:</strong> <span t-esc="order.partner_id.name"/>
            </div>
        </t>
    </t>
</templates>
