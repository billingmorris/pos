<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="pos_receipt_inherit" inherit_id="point_of_sale.pos_receipt">

        <xpath expr="//div[@class='pos-receipt']" position="inside">
            <div class="pos-total-qty">
                <strong>Total productos: </strong>
                <t t-esc="o.total_qty"/>
            </div>
        </xpath>

    </template>
</odoo>
