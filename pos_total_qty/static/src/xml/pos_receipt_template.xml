<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Insertar total_qty en el ticket -->
    <t t-name="pos_total_qty.TicketPatch" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'receipt-paymentlines')]" position="after">
            <div class="pos-total-qty">
                <strong>Total productos:</strong>
                <t t-esc="receipt.total_qty"/>
            </div>
        </xpath>
    </t>

</templates>
